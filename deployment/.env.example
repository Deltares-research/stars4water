# STARS4Water public deployment runs without Microsoft SSO.
# Keep auth disabled unless you also provide AZURE_* credentials and APP_SECRET_KEY.
AUTH_ENABLED=false
PUBLIC_READ_ENABLED=true

# APP_DOMAIN builds the OAuth redirect URI as https://{APP_DOMAIN}/api/auth/callback,
# which must be registered in Azure App Registration and must be served over TLS.
# Unused while AUTH_ENABLED=false.
APP_DOMAIN=
ENVIRONMENT=production
# Session cookie is only sent over HTTPS. Requires TLS on nginx.
COOKIE_SECURE=true
STAC_FASTAPI_TITLE=STARS4Water STAC API
STAC_FASTAPI_DESCRIPTION=A STAC API containing STARS4Water datasets
STAC_FASTAPI_VERSION=3.0.0a2
APP_HOST=0.0.0.0
APP_PORT=8000
RELOAD=true
WEB_CONCURRENCY=10
ADMIN_USERS=Ioanna.Micha@deltares.nl
# Unused while AUTH_ENABLED=false.
FRONTEND_URL=
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=
DB_CONNECTION_URL=
HARBOR_REGISTRY=
BACKEND_FOLDER=backend-stars4water
FRONTEND_FOLDER=frontend-stars4water
IMAGE_TAG=

# Frontend.
# Runtime, server-only. Where server-side rendering reaches the backend.
NUXT_INTERNAL_API_BASE_URL=http://backend:8000/api

# Runtime, public. NUXT_PUBLIC_* values are visible in browser devtools.
NUXT_PUBLIC_MAPBOX_TOKEN=
NUXT_PUBLIC_ABOUT_TAB_ENABLED=true
NUXT_PUBLIC_AUTH_ENABLED=false
NUXT_PUBLIC_REGISTER_TAB_ENABLED=false
NUXT_PUBLIC_ADMIN_TABS_ENABLED=false